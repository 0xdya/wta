#!/usr/bin/env bash
VERSION="2.0.1"
apps="$HOME/.local/share/applications"
icons="$HOME/.local/share/icons/wta"

# المتصفحات المبنية على Chromium (تدعم --app)
chromium_based='chromium|chrome|brave|vivaldi|edge|opera|thorium|ungoogled|helium-browser'

desktop_dirs=(
    "$HOME/.local/share/applications"
    /usr/local/share/applications
    /usr/share/applications
    /var/lib/flatpak/exports/share/applications
    "$HOME/.local/share/flatpak/exports/share/applications"
    /var/lib/snapd/desktop/applications
)

usage() {
    echo "Usage: wta                  (interactive mode)"
    echo "       wta name url [icon]"
    echo "To show list: wta -l"
    echo "To remove: wta -r name"
    echo "To update: wta -u"
    echo ""
    echo "Browser: uses your default browser if it is Chromium-based."
    echo "Override with: WTA_BROWSER=brave wta name url"
    exit "${1:-1}"
}

# اسم الملف
slugify() {
    echo "$1" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//'
}

# ازالة المسافات
trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    echo "$s"
}

# تحويل الرابط النسبي إلى رابط كامل
full_url() {
    case "$1" in
        http*) echo "$1" ;;
        //*) echo "https:$1" ;;
        /*) echo "$origin$1" ;;
        *) echo "$origin/$1" ;;
    esac
}

# جلب href من وسم link حسب قيمة rel
get_href() {
    echo "$page" | tr '\n' ' ' | grep -oiE '<link[^>]*>' \
        | grep -iE "rel=[\"']$1[\"']" | head -n 1 \
        | sed -n "s/.*href=[\"']\([^\"']*\)[\"'].*/\1/p"
}

# تحميل الصورة وتحويلها إلى PNG
try_icon() {
    tmp=$(mktemp)
    if [ -f "$1" ]; then
        cp "$1" "$tmp"
    else
        curl -fsSL --max-time 10 -o "$tmp" "$1" 2>/dev/null
    fi
    "${im_cmd[@]}" "${tmp}[0]" -background none -resize 256x256 "$out" 2>/dev/null
    status=$?
    rm -f "$tmp"
    [ $status -ne 0 ] && rm -f "$out"
    return $status
}

# استخراج أمر التشغيل من سطر Exec وإزالة رموز مثل %U @...
clean_exec() {
    sed -E 's/ %[a-zA-Z]//g; s/ @@u?//g'
}

# البحث عن المتصفحات المبنية على Chromium المثبتة في النظام
find_browsers() {
    local dir f entry name cmd seen=""
    b_names=()
    b_cmds=()

    for dir in "${desktop_dirs[@]}"; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.desktop; do
            [ -f "$f" ] || continue

            entry=$(awk '/^\[/{s=($0=="[Desktop Entry]")} s' "$f")

            echo "$entry" | grep -q '^NoDisplay=true' && continue
            echo "$entry" | grep -q '^Categories=.*WebBrowser' || continue

            cmd=$(echo "$entry" | sed -n 's/^Exec=//p' | head -n 1 | clean_exec)
            echo "$cmd" | grep -qiE "$chromium_based" || continue

            name=$(echo "$entry" | sed -n 's/^Name=//p' | head -n 1)
            [ -z "$name" ] && continue

            # تجاهل المتصفح المكرر (نفس الاسم في أكثر من مسار)
            case "$seen" in *"|$name|"*) continue ;; esac
            seen="$seen|$name|"

            b_names+=("$name")
            b_cmds+=("$cmd")
        done
    done
}

# اكتشاف المتصفح الافتراضي وجعله أمر تشغيل
detect_browser() {
    local desktop_file cmd candidate dir

    # المتصفح الذي اختاره المستخدم في الوضع التفاعلي
    if [ -n "$chosen_browser" ]; then
        echo "$chosen_browser"
        return
    fi

    # المتغير اليدوي له الأولوية
    if [ -n "$WTA_BROWSER" ]; then
        echo "$WTA_BROWSER"
        return
    fi

    # المتصفح الافتراضي من النظام
    desktop_file=$(xdg-settings get default-web-browser 2>/dev/null)
    if [ -z "$desktop_file" ]; then
        desktop_file=$(xdg-mime query default x-scheme-handler/https 2>/dev/null)
    fi

    if [ -n "$desktop_file" ]; then
        for dir in "${desktop_dirs[@]}"; do
            if [ -f "$dir/$desktop_file" ]; then
                cmd=$(sed -n 's/^Exec=//p' "$dir/$desktop_file" | head -n 1 | clean_exec)
                # تحقق أنه مبني ع Chromium
                if echo "$cmd" | grep -qiE "$chromium_based"; then
                    echo "$cmd"
                    return
                fi
                break
            fi
        done
    fi

    for candidate in chromium chromium-browser google-chrome-stable google-chrome \
                     brave brave-browser vivaldi microsoft-edge-stable; do
        if command -v "$candidate" >/dev/null 2>&1; then
            echo "$candidate"
            return
        fi
    done

    echo "chromium"
}

# عرض قائمة التطبيقات
list_apps() {
    local files f app_name app_url
    shopt -s nullglob
    files=("$apps"/wta-*.desktop)
    if [ ${#files[@]} -eq 0 ]; then
        echo "No apps found"
        exit 0
    fi
    for f in "${files[@]}"; do
        app_name=$(sed -n 's/^Name=//p' "$f")
        app_url=$(sed -n 's/^Exec=.*--app="\([^"]*\)".*/\1/p' "$f")
        app_url="${app_url//\%\%/%}"
        echo "- $app_name ($app_url)"
    done
    exit 0
}

# الحذف
remove_app() {
    local target="$1" slug file icon

    slug=$(slugify "$target")
    file="$apps/wta-$slug.desktop"

    # البحث داخل الملفات في حالة الاسم بلغة عربية أو...
    if [ -z "$slug" ] || [ ! -f "$file" ]; then
        file=$(grep -lxF "Name=$target" "$apps"/wta-*.desktop 2>/dev/null | head -n 1)
    fi

    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo "App not found"
        exit 1
    fi

    # مسار الأيقونة يؤخذ من الملف نفسه
    icon=$(sed -n 's/^Icon=//p' "$file" | head -n 1)
    rm -f "$file"
    case "$icon" in
        "$icons"/*) rm -f "$icon" ;;
    esac

    echo "App removed"
    exit 0
}

# إنشاء التطبيق
create_app() {
    local name="$1" url="$2" icon_src="$3"
    local domain slug rel href icon browser

    # إضافة https إن لم يكن موجودًا
    case "$url" in
        http://*|https://*) ;;
        *) url="https://$url" ;;
    esac

    origin=$(echo "$url" | sed -E 's|^(https?://[^/]*).*|\1|')
    domain=${origin#*://}
    domain=${domain%%:*}
    domain=${domain#www.}

    # إذا لم يبق شيء من الاسم نستخدم الدومين
    slug=$(slugify "$name")
    [ -z "$slug" ] && slug=$(slugify "$domain")

    # أداة تحويل الصور: ImageMagick 7 (magick) أو 6 (convert)
    if command -v magick >/dev/null 2>&1; then
        im_cmd=(magick)
    elif command -v convert >/dev/null 2>&1; then
        im_cmd=(convert)
    else
        im_cmd=()
    fi

    mkdir -p "$apps" "$icons"
    out="$icons/$slug.png"
    found=0

    # الأيقونة
    if [ ${#im_cmd[@]} -eq 0 ]; then
        echo "ImageMagick not found, using the generic icon"
    elif [ -n "$icon_src" ]; then
        icon_src="${icon_src/#\~/$HOME}"
        try_icon "$icon_src" && found=1
    else
        page=$(curl -fsSL --max-time 10 "$url" 2>/dev/null)
        for rel in 'apple-touch-icon(-precomposed)?' '(shortcut )?icon'; do
            href=$(get_href "$rel")
            [ -n "$href" ] && try_icon "$(full_url "$href")" && found=1 && break
        done
        [ $found -eq 0 ] && try_icon "$origin/favicon.ico" && found=1
        [ $found -eq 0 ] && try_icon "https://www.google.com/s2/favicons?domain=$domain&sz=128" && found=1
    fi

    if [ $found -eq 1 ]; then
        icon="$out"
    else
        icon="web-browser"
        [ ${#im_cmd[@]} -ne 0 ] && echo "No icon found, using the generic icon"
    fi

    browser=$(detect_browser)
    echo -e "\n Using browser: $browser"

    # ملف التطبيق
    cat > "$apps/wta-$slug.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Exec=$browser --app="${url//%/%%}" --ozone-platform-hint=auto
Icon=$icon
Terminal=false
Categories=Network;
EOF

    command -v update-desktop-database >/dev/null && update-desktop-database "$apps"

    echo "App created"
}

update_app() {
    local repo="${WTA_REPO:-https://raw.githubusercontent.com/0xdya/wta/main}"
    local bin="$HOME/.local/bin/wta"
    local tmp remote_ver dl_ver

    command -v curl >/dev/null 2>&1 || { echo "curl is required"; exit 1; }

    # جلب الإصدار
    remote_ver=$(curl -fsSL --max-time 10 -r 0-2048 "$repo/src/wta" \
        | sed -n 's/^VERSION="\([^"]*\)"/\1/p' | head -n 1)

    if [ -z "$remote_ver" ]; then
        echo "Update failed: unable to determine remote version"
        exit 1
    fi

    # مقارنة الإصدارات
    if [ "$remote_ver" = "$VERSION" ]; then
        echo "Already up to date (v$VERSION)"
        exit 0
    fi

    # تحميل النسخة الجديدة بالكامل
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT

    if ! curl -fsSL --max-time 30 "$repo/src/wta" -o "$tmp"; then
        echo "Update failed: unable to download WTA"
        exit 1
    fi

    dl_ver=$(sed -n 's/^VERSION="\([^"]*\)"/\1/p' "$tmp" | head -n 1)
    if [ "$dl_ver" != "$remote_ver" ]; then
        echo "Update failed: version mismatch after download"
        exit 1
    fi

    if ! bash -n "$tmp"; then
        echo "Update failed: downloaded script is invalid"
        exit 1
    fi

    # نسخة احتياطية
    [ -f "$bin" ] && cp -f "$bin" "$bin.bak"

    chmod 755 "$tmp"
    mkdir -p "$(dirname "$bin")"
    if ! mv -f "$tmp" "$bin"; then
        echo "Update failed: unable to install WTA"
        exit 1
    fi

    trap - EXIT
    echo "Updated: v$VERSION -> v$remote_ver"
    echo "Restart or run: wta --help"
    exit 0
}

# الوضع التفاعلي
interactive() {
    local n i name url icon_src

    find_browsers
    if [ ${#b_names[@]} -eq 0 ]; then
        echo "No Chromium-based browser found"
        exit 1
    fi

    echo "Choose a browser:"
    for i in "${!b_names[@]}"; do
        echo "  $((i + 1))) ${b_names[$i]}"
    done

    while true; do
        if [ ${#b_names[@]} -eq 1 ]; then
            echo -e "Browser number (Enter for ${b_names[0]}):"
            read -er n
            [ -z "$n" ] && n=1
        else
            echo -e "\n Browser number:"
            read -er n
        fi
        n=$(trim "$n")
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#b_names[@]} ]; then
            break
        fi
        echo "Invalid number"
    done
    chosen_browser="${b_cmds[$((n - 1))]}"

    # الاسم
    while true; do
        echo -e "\n App name:"
        read -er name
        name=$(trim "$name")
        [ -n "$name" ] && break
        echo "Name cannot be empty"
    done

    # الرابط
    while true; do
        echo -e "\n URL:"
        read -er url
        url=$(trim "$url")
        [ -n "$url" ] && break
        echo "URL cannot be empty"
    done

    # الأيقونة اختيارية
    echo -e "\n Icon (path or URL), or Enter to fetch automatically:"
    read -er icon_src
    icon_src=$(trim "$icon_src")

    create_app "$name" "$url" "$icon_src"
}

case "${1:-}" in
    "")
        interactive
        ;;
    -h|--help)
        usage 0
        ;;
    -l)
        list_apps
        ;;
    -r)
        [ -z "$2" ] && usage
        remove_app "$2"
        ;;
    -u|--update)
        update_app
        ;;
    *)
        [ $# -lt 2 ] && usage
        create_app "$1" "$2" "$3"
        ;;
esac